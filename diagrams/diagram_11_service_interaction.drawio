<!-- DIAGRAM 11: COMPLETE SERVICE INTERACTION MAP -->
<mxfile host="app.diagrams.net">
  <diagram name="Service Interaction" id="diagram-11">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1800">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="COMPLETE SERVICE INTERACTION MAP" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="20" width="600" height="40" as="geometry"/>
        </mxCell>

        <!-- User Request -->
        <mxCell id="user-request" value="USER REQUEST&#xa;(Generate 3-day itinerary)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="550" y="80" width="300" height="60" as="geometry"/>
        </mxCell>

        <!-- First Layer: Route Service + User Service -->
        <mxCell id="route-service" value="Route Service&#xa;• Validate request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="200" width="200" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="user-service" value="User Service&#xa;• Get user preferences" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="850" y="200" width="200" height="60" as="geometry"/>
        </mxCell>

        <!-- Second Layer: L1 Cache + POI Service -->
        <mxCell id="redis-l1" value="Redis L1 Cache&#xa;Check cached route" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e51400;fontColor=#ffffff;strokeColor=#B20000;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="320" width="200" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="poi-service" value="POI Service&#xa;Fetch candidates" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="850" y="320" width="200" height="60" as="geometry"/>
        </mxCell>

        <!-- Cache HIT path (short path to return) -->
        <mxCell id="cache-hit-label" value="CACHE HIT" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#60a917;" vertex="1" parent="1">
          <mxGeometry x="100" y="350" width="80" height="30" as="geometry"/>
        </mxCell>

        <!-- Third Layer: L2 Cache + PostgreSQL -->
        <mxCell id="redis-l2" value="Redis L2 Cache&#xa;POI Metadata" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e51400;fontColor=#ffffff;strokeColor=#B20000;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="850" y="440" width="200" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="cache-miss-label" value="MISS" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#e51400;" vertex="1" parent="1">
          <mxGeometry x="1070" y="465" width="60" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="postgresql" value="PostgreSQL + PostGIS&#xa;Query goa_places" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1ba1e2;fontColor=#ffffff;strokeColor=#006EAF;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="850" y="560" width="200" height="60" as="geometry"/>
        </mxCell>

        <!-- Fourth Layer: Recommendation Service -->
        <mxCell id="recommendation" value="Recommendation Service&#xa;• Score POIs&#xa;• Content-based (40%)&#xa;• Popularity (30%)&#xa;• Context (30%)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="850" y="680" width="200" height="100" as="geometry"/>
        </mxCell>

        <!-- Fifth Layer: Distance Calculator + L3 Cache -->
        <mxCell id="distance-calc" value="Distance Calculator&#xa;• Check L3 cache&#xa;• Query distance_matrix&#xa;• Haversine fallback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="850" y="840" width="200" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="redis-l3" value="Redis L3 Cache&#xa;Distance Matrix&#xa;TTL: 7 days" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e51400;fontColor=#ffffff;strokeColor=#B20000;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1130" y="860" width="180" height="80" as="geometry"/>
        </mxCell>

        <!-- Sixth Layer: Optimization Service -->
        <mxCell id="optimization" value="Optimization Service&#xa;• Select algorithm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="850" y="1000" width="200" height="60" as="geometry"/>
        </mxCell>

        <!-- Seventh Layer: Algorithm Layer -->
        <mxCell id="algorithms" value="Algorithm Layer&#xa;• Genetic Algorithm (GA)&#xa;• Simulated Annealing (SA)&#xa;• Tabu Search (TS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#60a917;fontColor=#ffffff;strokeColor=#2D7600;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="850" y="1120" width="200" height="90" as="geometry"/>
        </mxCell>

        <!-- Eighth Layer: Map Service -->
        <mxCell id="map-service" value="Map Service&#xa;• Get directions&#xa;• Route geometry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="850" y="1270" width="200" height="70" as="geometry"/>
        </mxCell>

        <!-- Final Layer: Save + Cache -->
        <mxCell id="save-db" value="Save to&#xa;user_routes table" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1ba1e2;fontColor=#ffffff;strokeColor=#006EAF;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="650" y="1400" width="180" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="cache-l1-save" value="Cache in Redis&#xa;L1 (1hr TTL)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e51400;fontColor=#ffffff;strokeColor=#B20000;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="950" y="1400" width="180" height="60" as="geometry"/>
        </mxCell>

        <!-- Return -->
        <mxCell id="return" value="Return Itinerary&#xa;• 3-day route&#xa;• Map data&#xa;• Statistics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="650" y="1520" width="280" height="80" as="geometry"/>
        </mxCell>

        <!-- External Integration Panel -->
        <mxCell id="external-bg" value="EXTERNAL INTEGRATION POINTS" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="280" height="240" as="geometry"/>
        </mxCell>

        <mxCell id="google-places" value="Google Places API&#xa;→ POI Service&#xa;(data collection)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0a30a;fontColor=#000000;strokeColor=#BD7000;" vertex="1" parent="external-bg">
          <mxGeometry x="30" y="40" width="230" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="google-maps" value="Google Maps API&#xa;→ Distance Calculator&#xa;→ Map Service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0a30a;fontColor=#000000;strokeColor=#BD7000;" vertex="1" parent="external-bg">
          <mxGeometry x="30" y="110" width="230" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="openweather" value="OpenWeather API&#xa;→ Weather Monitor&#xa;(every 30min)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0a30a;fontColor=#000000;strokeColor=#BD7000;" vertex="1" parent="external-bg">
          <mxGeometry x="30" y="180" width="230" height="50" as="geometry"/>
        </mxCell>

        <!-- Background Processes Panel -->
        <mxCell id="background-bg" value="BACKGROUND PROCESSES" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="840" width="280" height="300" as="geometry"/>
        </mxCell>

        <mxCell id="weather-monitor" value="Weather Monitor (polling)&#xa;→ Adaptation Trigger&#xa;→ Notification Service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1" parent="background-bg">
          <mxGeometry x="30" y="40" width="230" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="notification" value="Notification Service&#xa;→ WebSocket/Push/Email" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1" parent="background-bg">
          <mxGeometry x="30" y="120" width="230" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="cache-warmer" value="Cache Warmer (on startup)&#xa;→ Redis L1/L2/L3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e51400;fontColor=#ffffff;strokeColor=#B20000;" vertex="1" parent="background-bg">
          <mxGeometry x="30" y="190" width="230" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="view-refresh" value="Materialized View Refresh&#xa;(daily) → PostgreSQL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1ba1e2;fontColor=#ffffff;strokeColor=#006EAF;" vertex="1" parent="background-bg">
          <mxGeometry x="30" y="260" width="230" height="40" as="geometry"/>
        </mxCell>

        <!-- Arrows - Main Flow -->
        <mxCell edge="1" parent="1" source="user-request" target="route-service">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell edge="1" parent="1" source="user-request" target="user-service">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell edge="1" parent="1" source="route-service" target="redis-l1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell edge="1" parent="1" source="user-service" target="poi-service">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Cache HIT path -->
        <mxCell edge="1" parent="1" source="redis-l1" target="cache-l1-save" style="strokeColor=#60a917;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="120" y="350"/>
              <mxPoint x="120" y="1430"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Cache MISS path -->
        <mxCell edge="1" parent="1" source="poi-service" target="redis-l2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell edge="1" parent="1" source="redis-l2" target="postgresql">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell edge="1" parent="1" source="postgresql" target="recommendation">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell edge="1" parent="1" source="recommendation" target="distance-calc">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell edge="1" parent="1" source="distance-calc" target="redis-l3" style="dashed=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell edge="1" parent="1" source="distance-calc" target="optimization">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell edge="1" parent="1" source="optimization" target="algorithms">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell edge="1" parent="1" source="algorithms" target="map-service">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell edge="1" parent="1" source="map-service" target="save-db">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell edge="1" parent="1" source="map-service" target="cache-l1-save">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell edge="1" parent="1" source="save-db" target="return">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell edge="1" parent="1" source="cache-l1-save" target="return">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Compliance Note -->
        <mxCell id="note" value="NOTE: Shows all 9 services from validated architecture v2.0.&#xa;Uses content-based filtering only (NO collaborative filtering).&#xa;NO traffic or crowd monitoring (per project scope)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;size=20;fontSize=11;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="370" y="1520" width="240" height="110" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
