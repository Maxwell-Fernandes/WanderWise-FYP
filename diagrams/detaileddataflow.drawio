          <mxGeometry x="460" y="220" width="280" height="150" as="geometry" />
        </mxCell>
        
        <!-- Logistic Regression -->
        <mxCell id="nlc-lr" value="LOGISTIC REGRESSION CLASSIFIER&lt;br&gt;Multi-label classification with sigmoid outputs&lt;br&gt;&lt;br&gt;Categories:&lt;br&gt;• beaches (0.92)&lt;br&gt;• historical (0.85)&lt;br&gt;• nature (0.31)&lt;br&gt;• adventure (0.18)&lt;br&gt;• dining (0.45)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffccbc;strokeColor=#d84315;" vertex="1" parent="1">
          <mxGeometry x="820" y="220" width="280" height="150" as="geometry" />
