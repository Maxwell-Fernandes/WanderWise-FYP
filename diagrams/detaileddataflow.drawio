        <!-- PostgreSQL + PostGIS -->
        <mxCell id="deploy-db" value="POSTGRESQL + POSTGIS&lt;br&gt;goa_places, distance_matrix, user_trips, itineraries" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffccbc;strokeColor=#d84315;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="500" y="500" width="600" height="60" as="geometry" />
        </mxCell>
        
        <!-- Arrow from Redis to DB -->
        <mxCell id="deploy-arr5" value="" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="800" y="440" as="sourcePoint" />
            <mxPoint x="800" y="500" as="targetPoint" />
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
