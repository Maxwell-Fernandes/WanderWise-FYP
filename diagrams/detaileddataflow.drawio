  <diagram id="page-4" name="Module IV - GA">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <mxCell id="ga-title" value="MODULE IV: Genetic Algorithm Routing" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="40" width="800" height="50" as="geometry" />
        </mxCell>
        
        <!-- Input - FIXED: Shows Day Clusters + WPI Scores -->
        <mxCell id="ga-input" value="INPUT: Day clusters (from Module III), WPI scores (from Module II), distance_matrix" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0e0e0;strokeColor=#616161;" vertex="1" parent="1">
          <mxGeometry x="300" y="100" width="1000" height="40" as="geometry" />
        </mxCell>
        
        <!-- FIXED: Population Init BEFORE Generation Loop -->
        <mxCell id="ga-init" value="POPULATION INITIALIZATION&lt;br&gt;Generate 100 random routes (permutations)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1565c0;" vertex="1" parent="1">
          <mxGeometry x="80" y="170" width="280" height="80" as="geometry" />
        </mxCell>
        
        <!-- Generation Loop -->
        <mxCell id="ga-loop" value="GENERATION LOOP (max 75 generations)" style="swimlane;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#f3e5f5;strokeColor=#7b1fa2;startSize=30;" vertex="1" parent="1">
          <mxGeometry x="440" y="150" width="650" height="250" as="geometry" />
        </mxCell>
        
        <mxCell id="ga-selection" value="TOURNAMENT SELECTION&lt;br&gt;• Tournament size: 4&lt;br&gt;• Select parents based on fitness&lt;br&gt;• Maintains selection pressure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#6a1b9a;" vertex="1" parent="ga-loop">
          <mxGeometry x="20" y="60" width="150" height="90" as="geometry" />
        </mxCell>
        
        <mxCell id="ga-crossover" value="COX CROSSOVER (85%)&lt;br&gt;Copy Order Crossover:&lt;br&gt;1. Copy from Parent 1&lt;br&gt;2. Fill from Parent 2&lt;br&gt;43.89% better than PMX" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffccbc;strokeColor=#d84315;" vertex="1" parent="ga-loop">
          <mxGeometry x="210" y="60" width="160" height="90" as="geometry" />
        </mxCell>
        
        <mxCell id="ga-mutation" value="SWAP MUTATION (15%)&lt;br&gt;Randomly swap two POIs&lt;br&gt;Maintains diversity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;" vertex="1" parent="ga-loop">
          <mxGeometry x="410" y="60" width="140" height="90" as="geometry" />
        </mxCell>
        
        <mxCell id="ga-fitness" value="FITNESS EVALUATION&lt;br&gt;fitness = 0.25×travel + 0.25×popularity&lt;br&gt;+ 0.25×waiting + 0.25×constraints&lt;br&gt;× diversity_bonus (1.0 + 0.1×diversity)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#e65100;" vertex="1" parent="ga-loop">
          <mxGeometry x="20" y="180" width="280" height="100" as="geometry" />
        </mxCell>
        
        <mxCell id="ga-elitism" value="ELITISM&lt;br&gt;Preserve top 2 solutions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcdd2;strokeColor=#c62828;" vertex="1" parent="ga-loop">
          <mxGeometry x="340" y="180" width="150" height="60" as="geometry" />
        </mxCell>
        
        <!-- Convergence Check (NEW) -->
        <mxCell id="ga-converge" value="Convergence?&lt;br&gt;Max generations or fitness plateau" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#fbc02d;" vertex="1" parent="1">
          <mxGeometry x="1160" y="220" width="120" height="100" as="geometry" />
        </mxCell>
        
        <!-- Output -->
        <mxCell id="ga-output" value="OUTPUT: Optimized daily route with visit order" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#7b1fa2;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="500" y="460" width="600" height="50" as="geometry" />
        </mxCell>
        
        <!-- FIXED Arrows -->
        <mxCell id="ga-arrow1" value="" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="360" y="210" as="sourcePoint" />
            <mxPoint x="440" y="210" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ga-arrow2" value="" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="1090" y="350" as="sourcePoint" />
            <mxPoint x="1160" y="350" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ga-arrow3" value="No" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;" vertex="1" parent="1">
          <mxPoint x="1000" y="400" as="geometry" />
        </mxCell>
        <mxCell id="ga-arrow4" value="Yes" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;" vertex="1" parent="1">
          <mxPoint x="1280" y="270" as="geometry" />
        </mxCell>
        <mxCell id="ga-arrow5" value="" style="endArrow=classic;html=1;strokeWidth=2;dashed=1;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="1280" y="320" as="sourcePoint" />
            <mxPoint x="1090" y="320" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ga-arrow6" value="" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="1280" y="320" as="sourcePoint" />
            <mxPoint x="1280" y="460" as="targetPoint" />
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  
  <diagram id="page-5" name="End-to-End Data Flow">
    <mxGraphModel dx="2400" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1600">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <mxCell id="flow-title" value="COMPLETE END-TO-END DATA FLOW" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="40" width="800" height="50" as="geometry" />
        </mxCell>
        
        <!-- User Layer -->
        <mxCell id="flow-user" value="USER INTERFACE LAYER&lt;br&gt;User Input: &quot;I want a relaxing 5-day beach trip with history&quot;&lt;br&gt;Trip Config: duration=5, start_date=2024-12-15, budget=standard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#fbc02d;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="800" y="100" width="800" height="60" as="geometry" />
        </mxCell>
        
        <!-- API Request -->
        <mxCell id="flow-api-req" value="POST /api/planning/start-trip&lt;br&gt;{user_input, trip_duration_days, start_date, budget}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0e0e0;strokeColor=#616161;" vertex="1" parent="1">
          <mxGeometry x="800" y="200" width="800" height="50" as="geometry" />
        </mxCell>
        
        <!-- FastAPI Gateway -->
        <mxCell id="flow-gateway" value="FASTAPI GATEWAY&lt;br&gt;Route to appropriate module endpoint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1565c0;" vertex="1" parent="1">
          <mxGeometry x="800" y="290" width="800" height="50" as="geometry" />
        </mxCell>
        
        <!-- Module I: NLC -->
        <mxCell id="flow-nlc" value="MODULE I: NLC CLASSIFIER&lt;br&gt;Input: User text&lt;br&gt;Process: TF-IDF → Logistic Regression&lt;br&gt;Output: {beaches: 0.92, historical: 0.85, ...}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;" vertex="1" parent="1">
          <mxGeometry x="800" y="380" width="800" height="70" as="geometry" />
        </mxCell>
        
        <!-- Database: POI Retrieval -->
        <mxCell id="flow-db-retrieve" value="DATABASE: POI RETRIEVAL&lt;br&gt;Query: SELECT * FROM goa_places WHERE category IN (beaches, historical)&lt;br&gt;Output: [POI objects]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffccbc;strokeColor=#d84315;" vertex="1" parent="1">
          <mxGeometry x="800" y="490" width="800" height="70" as="geometry" />
        </mxCell>
        
        <!-- PARALLEL: Module II and Module III -->
        <mxCell id="flow-parallel" value="PARALLEL PROCESSING" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1100" y="590" width="200" height="30" as="geometry" />
        </mxCell>
        
        <!-- Module II: WPI -->
        <mxCell id="flow-wpi" value="MODULE II: WPI SCORING&lt;br&gt;WPI = 0.35×review + 0.25×engagement + 0.25×temporal + 0.15×geo&lt;br&gt;Output: {poi_id: wpi_score}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#7b1fa2;" vertex="1" parent="1">
          <mxGeometry x="400" y="650" width="450" height="80" as="geometry" />
        </mxCell>
        
        <!-- Module III: Clustering -->
        <mxCell id="flow-cluster" value="MODULE III: GEOGRAPHIC CLUSTERING&lt;br&gt;K-means++ with Haversine distance&lt;br&gt;Output: {day_1: [POIs...], day_2: [POIs...], ...}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcdd2;strokeColor=#c62828;" vertex="1" parent="1">
          <mxGeometry x="1000" y="650" width="450" height="80" as="geometry" />
        </mxCell>
        
        <!-- Module IV: GA -->
        <mxCell id="flow-ga" value="MODULE IV: GENETIC ALGORITHM&lt;br&gt;Input: Day clusters + WPI scores&lt;br&gt;Process: Tournament → COX crossover → Swap mutation → Fitness eval&lt;br&gt;Output: Optimized routes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#e65100;" vertex="1" parent="1">
          <mxGeometry x="800" y="770" width="800" height="80" as="geometry" />
        </mxCell>
        
        <!-- Response Assembly -->
        <mxCell id="flow-response" value="RESPONSE ASSEMBLY&lt;br&gt;Combine all module outputs into final itinerary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1565c0;" vertex="1" parent="1">
          <mxGeometry x="800" y="890" width="800" height="50" as="geometry" />
        </mxCell>
        
        <!-- API Response -->
        <mxCell id="flow-api-resp" value="API RESPONSE&lt;br&gt;{success: true, itinerary_id, daily_itineraries, total_distance_km, ...}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="800" y="980" width="800" height="50" as="geometry" />
        </mxCell>
        
        <!-- Frontend Display -->
        <mxCell id="flow-frontend" value="FRONTEND DISPLAY&lt;br&gt;• Interactive map with route visualization&lt;br&gt;• Day-by-day itinerary cards&lt;br&gt;• POI details with ratings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#7b1fa2;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="800" y="1070" width="800" height="70" as="geometry" />
        </mxCell>
        
        <!-- Arrows for parallel flow -->
