  <diagram id="page-6" name="Database Schema">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <mxCell id="db-title" value="DATABASE SCHEMA" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="40" width="480" height="50" as="geometry" />
        </mxCell>
        
        <!-- goa_places table -->
        <mxCell id="tbl-places" value="goa_places" style="swimlane;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1976d2;startSize=30;" vertex="1" parent="1">
          <mxGeometry x="80" y="120" width="320" height="200" as="geometry" />
        </mxCell>
        <mxCell id="tbl-places-col1" value="id UUID PRIMARY KEY DEFAULT gen_random_uuid()" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="tbl-places">
          <mxGeometry x="10" y="40" width="300" height="20" as="geometry" />
        </mxCell>
        <mxCell id="tbl-places-col2" value="name VARCHAR(255) NOT NULL" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="tbl-places">
          <mxGeometry x="10" y="65" width="300" height="20" as="geometry" />
        </mxCell>
        <mxCell id="tbl-places-col3" value="latitude DECIMAL(9, 6) NOT NULL" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="tbl-places">
          <mxGeometry x="10" y="90" width="300" height="20" as="geometry" />
        </mxCell>
        <mxCell id="tbl-places-col4" value="longitude DECIMAL(9, 6) NOT NULL" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="tbl-places">
          <mxGeometry x="10" y="115" width="300" height="20" as="geometry" />
        </mxCell>
        <mxCell id="tbl-places-col5" value="category VARCHAR(100) NOT NULL" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="tbl-places">
          <mxGeometry x="10" y="140" width="300" height="20" as="geometry" />
        </mxCell>
        <mxCell id="tbl-places-col6" value="popularity_score DECIMAL(3, 2) DEFAULT 5.0" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="tbl-places">
          <mxGeometry x="10" y="165" width="300" height="20" as="geometry" />
        </mxCell>
        
        <!-- distance_matrix table -->
        <mxCell id="tbl-distance" value="distance_matrix" style="swimlane;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;startSize=30;" vertex="1" parent="1">
          <mxGeometry x="460" y="120" width="320" height="140" as="geometry" />
        </mxCell>
        <mxCell id="tbl-dist-col1" value="poi1_id UUID REFERENCES goa_places(id)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="tbl-distance">
          <mxGeometry x="10" y="40" width="300" height="20" as="geometry" />
        </mxCell>
        <mxCell id="tbl-dist-col2" value="poi2_id UUID REFERENCES goa_places(id)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="tbl-distance">
          <mxGeometry x="10" y="65" width="300" height="20" as="geometry" />
        </mxCell>
        <mxCell id="tbl-dist-col3" value="distance_km DECIMAL(10, 2) NOT NULL" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="tbl-distance">
          <mxGeometry x="10" y="90" width="300" height="20" as="geometry" />
        </mxCell>
        <mxCell id="tbl-dist-col4" value="travel_time_minutes INTEGER" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="tbl-distance">
          <mxGeometry x="10" y="115" width="300" height="20" as="geometry" />
