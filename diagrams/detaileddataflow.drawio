  <diagram id="page-3" name="Module III - K-Means">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <mxCell id="kmeans-title" value="MODULE III: Geographic Clustering (K-Means)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="40" width="800" height="50" as="geometry" />
        </mxCell>
        
        <!-- Input -->
        <mxCell id="kmeans-input" value="INPUT: 50 POIs + WPI scores, K = 5 (trip duration)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0e0e0;strokeColor=#616161;" vertex="1" parent="1">
          <mxGeometry x="400" y="100" width="800" height="40" as="geometry" />
        </mxCell>
        
        <!-- K-Means++ - CORRECTLY positioned before iterative loop -->
        <mxCell id="kmeans-init" value="K-MEANS++ INITIALIZATION&lt;br&gt;Step 1: Select 1st centroid randomly&lt;br&gt;Step 2-N: Select with probability ∝ D(x)²&lt;br&gt;(D(x) = distance to nearest existing centroid)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1565c0;" vertex="1" parent="1">
          <mxGeometry x="80" y="180" width="340" height="120" as="geometry" />
        </mxCell>
        
        <!-- Iterative Loop -->
        <mxCell id="kmeans-loop" value="ITERATIVE LOOP (max 100 iterations)" style="swimlane;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#c8e6c9;strokeColor=#388e3c;startSize=30;" vertex="1" parent="1">
          <mxGeometry x="500" y="160" width="450" height="200" as="geometry" />
        </mxCell>
        
        <mxCell id="kmeans-assign" value="ASSIGNMENT STEP&lt;br&gt;For each POI: Assign to cluster&lt;br&gt;with nearest centroid&lt;br&gt;Using Haversine distance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#a5d6a7;strokeColor=#2e7d32;" vertex="1" parent="kmeans-loop">
          <mxGeometry x="20" y="50" width="180" height="100" as="geometry" />
        </mxCell>
        
        <mxCell id="kmeans-update" value="UPDATE STEP&lt;br&gt;For each cluster:&lt;br&gt;centroid = mean(lat, lon)&lt;br&gt;of assigned POIs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#a5d6a7;strokeColor=#2e7d32;" vertex="1" parent="kmeans-loop">
          <mxGeometry x="240" y="50" width="180" height="100" as="geometry" />
        </mxCell>
        
        <!-- Convergence Check -->
        <mxCell id="kmeans-converge" value="Convergence? &lt;br&gt;WCSS improvement &lt; 1e-4" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#fbc02d;" vertex="1" parent="1">
          <mxGeometry x="1030" y="200" width="120" height="100" as="geometry" />
        </mxCell>
        
        <!-- Edge Cases -->
        <mxCell id="kmeans-edge" value="EDGE CASE HANDLING&lt;br&gt;• Rebalance imbalanced clusters (min 6, max 15 POIs)&lt;br&gt;• Handle empty clusters (reinitialize)&lt;br&gt;• Detect and flag outlier POIs (&gt;30km from center)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffccbc;strokeColor=#d84315;" vertex="1" parent="1">
          <mxGeometry x="80" y="450" width="340" height="140" as="geometry" />
        </mxCell>
        
        <!-- Output -->
        <mxCell id="kmeans-output" value="OUTPUT: {day_1: [POIs...], day_2: [POIs...], ...}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#7b1fa2;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="500" y="450" width="600" height="50" as="geometry" />
        </mxCell>
        
        <!-- Arrows -->
        <mxCell id="kmeans-arrow1" value="" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="420" y="240" as="sourcePoint" />
            <mxPoint x="500" y="220" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="kmeans-arrow2" value="" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="950" y="260" as="sourcePoint" />
            <mxPoint x="1030" y="250" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="kmeans-arrow3" value="No" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="960" y="310" width="60" height="30" as="geometry" />
        </mxCell>
        <mxCell id="kmeans-arrow4" value="Yes" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1150" y="250" width="60" height="30" as="geometry" />
        </mxCell>
        <mxCell id="kmeans-arrow5" value="" style="endArrow=classic;html=1;strokeWidth=2;dashed=1;" edge="1" parent="1">
