        </mxCell>

        <mxCell id="stats" value="CACHE STATISTICS TARGET:&#xa;- Overall Hit Rate: &gt;70%&#xa;- L1 Response Time: &lt;10ms&#xa;- L2 Response Time: &lt;50ms&#xa;- L3 Response Time: &lt;100ms&#xa;- Cache Miss (Full Compute): &lt;5 seconds" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;" vertex="1" parent="1">
