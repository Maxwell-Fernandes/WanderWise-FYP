          <mxGeometry x="820" y="400" width="120" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="l3-cache" value="L3: Distance Matrix&#xa;(Redis + PostgreSQL)&#xa;TTL: 7 days&#xa;Hit Rate: 80-90%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="420" y="400" width="320" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="l3-compute" value="Compute&#xa;Using&#xa;Cached&#xa;Distances" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="820" y="540" width="120" height="70" as="geometry"/>
