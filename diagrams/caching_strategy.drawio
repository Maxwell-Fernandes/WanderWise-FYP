<!-- DIAGRAM 9: CACHING STRATEGY -->
<mxfile host="app.diagrams.net">
  <diagram name="Caching Strategy" id="diagram-9">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1200">
      <root>
        <mxCell id="0"/>
