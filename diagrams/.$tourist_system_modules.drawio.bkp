        <!-- MODULE I: User Profile & Interests -->
        <mxCell id="module1" value="&lt;b&gt;MODULE I&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;User Profile &amp;amp; Interests&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;(Natural Language Classification)&lt;/i&gt;&lt;br&gt;&lt;br&gt;• Analyze user preferences&lt;br&gt;• Detect interests from text&lt;br&gt;• Build user profile" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4F8;strokeColor=#4A90E2;strokeWidth=3;fontSize=12;align=center;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="80" y="120" width="200" height="160" as="geometry" />
        </mxCell>
        
        <!-- MODULE II: POI Popularity -->
